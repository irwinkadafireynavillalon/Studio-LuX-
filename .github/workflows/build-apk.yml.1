name: Build APK (assembleDebug)

on:
  push:
    branches: [ main ]
  workflow_dispatch:

jobs:
  build-apk:
    runs-on: ubuntu-latest
    env:
      ANDROID_SDK_ROOT: ${{ runner.temp }}/android-sdk
      GRADLE_VERSION: 8.3

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17

      - name: Install Android command-line tools
        run: |
          mkdir -p "${ANDROID_SDK_ROOT}"
          cd "${ANDROID_SDK_ROOT}"
          curl -sSL "https://dl.google.com/android/repository/commandlinetools-linux-9477386_latest.zip" -o cmdline.zip
          unzip -q cmdline.zip -d cmdline-temp
          mkdir -p cmdline-tools/latest
          mv cmdline-temp/cmdline-tools/* cmdline-tools/latest/
          rm -rf cmdline.zip cmdline-temp
          export PATH="${ANDROID_SDK_ROOT}/cmdline-tools/latest/bin:${PATH}"
          yes | "${ANDROID_SDK_ROOT}/cmdline-tools/latest/bin/sdkmanager" --sdk_root="${ANDROID_SDK_ROOT}" --licenses
          "${ANDROID_SDK_ROOT}/cmdline-tools/latest/bin/sdkmanager" --sdk_root="${ANDROID_SDK_ROOT}" "platform-tools" "platforms;android-36" "build-tools;36.0.0"

      - name: Download and unzip Gradle
        run: |
          curl -sSL "https://services.gradle.org/distributions/gradle-${{ env.GRADLE_VERSION }}-bin.zip" -o gradle.zip
          unzip -q gradle.zip -d $HOME
          rm gradle.zip
        shell: bash

      - name: Build APK
        run: |
          export GRADLE_HOME="$HOME/gradle-${{ env.GRADLE_VERSION }}"
          export PATH="$GRADLE_HOME/bin:$PATH"
          # If a gradlew exists, prefer it:
          if [ -x "./gradlew" ]; then
            chmod +x ./gradlew
            ./gradlew assembleDebug --no-daemon
          else
            gradle -v
            gradle assembleDebug --no-daemon
          fi
        env:
          ANDROID_HOME: ${{ env.ANDROID_SDK_ROOT }}
          ANDROID_SDK_ROOT: ${{ env.ANDROID_SDK_ROOT }}

      - name: Upload APK artifact
        uses: actions/upload-artifact@v4
        with:
          name: app-debug-apk
          path: app/build/outputs/apk/debug/*.apk
